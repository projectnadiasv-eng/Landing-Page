# Server-only. NEVER prefix any of these with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The ONE plan: Signal Pro, $47/month, access to everything in the app.
# Unset -> POST /api/signup answers 503 "not available yet" before it writes
# anything, rather than creating an account it cannot charge.
# STRIPE_PRICE_SIGNAL and STRIPE_PRICE_DESK are gone with the $27/$97 tiers;
# those prices are archived in Stripe, so do not reintroduce the vars.
STRIPE_PRICE_PRO=

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signal Pro CRM (a separate repo, project_nadia / nadia-sv.com). The webhook
# forwards normalised checkout/subscription/invoice events here — see
# docs/DEPLOY.md. SIGNAL_PRO_LANDING_SECRET must match the value set as
# SIGNAL_PRO_LANDING_SECRET on the nadia-web Vercel project.
SIGNAL_PRO_CRM_URL=https://nadia-sv.com
SIGNAL_PRO_LANDING_SECRET=

# The automatic sign-in (POST /api/handoff -> the CRM's /api/spro/handoff, which
# mints the link the browser follows into the app). Must match
# SIGNAL_PRO_HANDOFF_SECRET on the nadia-web Vercel project.
#
# DELIBERATELY NOT SIGNAL_PRO_LANDING_SECRET. That one authorises writing CRM
# rows; this one authorises minting a working session for a customer's account,
# so a leak of the fulfilment credential — presented on every signup and every
# webhook delivery — must not be turnable into an account takeover. Read in
# src/lib/handoff.ts and nowhere else.
#
# Unset: the overlay falls back to "we couldn't sign you in automatically" with
# a button to the app's own /login. Nothing breaks; the shortcut is missing.
# Generate with: openssl rand -hex 32
SIGNAL_PRO_HANDOFF_SECRET=

# Public destinations for the post-checkout handoff. Not secrets — these are
# URLs the browser navigates to, so they MUST be NEXT_PUBLIC_ to be readable
# from CheckoutSuccess.tsx.
#
# NEXT_PUBLIC_SIGNAL_PRO_APP_URL is where a paying customer signs in (the
# signal-pro webapp). Production already sets the server-only SIGNAL_PRO_APP_URL;
# the NEXT_PUBLIC_ variant has to be added alongside it or the confirmation
# overlay ships without its primary button.
#
# Since the automatic sign-in shipped (2026-09-05) this is the FALLBACK path,
# not the main one: on the ordinary journey the browser is redirected straight
# into the app by /api/handoff and nobody ever sees the button. It still has to
# be set — the fallback is what a customer gets on any handoff failure.
NEXT_PUBLIC_SIGNAL_PRO_APP_URL=

# Stripe's hosted Customer Portal LOGIN LINK (Dashboard > Settings > Billing >
# Customer portal). Configuration, not code — this repo creates no portal
# session. Optional: unset simply hides the "Manage billing" link.
NEXT_PUBLIC_STRIPE_PORTAL_LOGIN_URL=

# ---------------------------------------------------------------------------
# OPERATOR ITEMS — no env var, configured in the Vercel dashboard.
#
# POST /api/signup has real side effects: every accepted request creates a
# Stripe Customer and a permanent CRM lead row. src/lib/rate-limit.ts holds a
# best-effort in-memory limiter (5 requests / 10 min per IP) but it is
# PER-INSTANCE and resets on every cold start — it is not the control.
#
#   1. Vercel Firewall: add a rate-limit rule on /api/signup.
#   2. Vercel BotID: enable it for the signup form.
#
# The form also carries a hidden honeypot field ("website"); a filled one is
# answered with a success shape and does nothing. That is a speed bump too.
# ---------------------------------------------------------------------------
